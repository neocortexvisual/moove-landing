---
import './recursos.css';

const base = import.meta.env.BASE_URL;
const recursos = [
  {
    icon: 'carteirinha.svg',
    title: 'Carteirinha digital',
    description: 'Tenha sua identificação estudantil no aplicativo.',
  },
  {
    icon: 'mapa.svg',
    title: 'Mapa do transporte',
    description: 'Veja as rotas e acompanhe o deslocamento.',
  },
  {
    icon: 'presenca.svg',
    title: 'Registro de presença',
    description: 'Confirme sua presença no transporte escolar.',
  },
];
---

<section id="recursos" class="recursos" aria-label="Recursos do aplicativo">
  <ul class="resources">
    {recursos.map(({ icon, title, description }) => (
      <li class="resource">
        <img src={`${base}imagens/1.1/${icon}`} alt="" width="42" height="42" loading="lazy" />
        <h2>{title}</h2>
        <p>{description}</p>
      </li>
    ))}
  </ul>
</section>
